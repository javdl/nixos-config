+    public static let cloud = Placement(on: "cloud", name: "Cua Cloud")
+    /// A Space on one of your machines, by its id from `Spaces.hosts()`.
+    public static func host(id: String, name: String) -> Placement {
+        Placement(on: "host:\(id)", name: name)
+    }
+    /// The choices every Mac has; your machines that provide Spaces follow.
+    public static let builtIn: [Placement] = [.local, .cloud]
+
+    public var id: String { on }
+    public var isHost: Bool { on.hasPrefix("host:") }
+
+    // Identity is `on`: a machine renamed on the relay is the same place.
+    public static func == (a: Placement, b: Placement) -> Bool { a.on == b.on }
+    public func hash(into hasher: inout Hasher) { hasher.combine(on) }
+
+    enum CodingKeys: String, CodingKey { case on, name }
+
+    public init(from decoder: Decoder) throws {
+        // Bots saved before machines were a choice stored a bare string.
+        if let raw = try? decoder.singleValueContainer().decode(String.self) {
+            switch raw {
+            case "local": self = .local
+            case "cloud": self = .cloud
+            default:
+                throw DecodingError.dataCorrupted(.init(
+                    codingPath: decoder.codingPath, debugDescription: "unknown placement \(raw)"))
+            }
+            return
+        }
+        let c = try decoder.container(keyedBy: CodingKeys.self)
+        self.init(on: try c.decode(String.self, forKey: .on), name: try c.decode(String.self, forKey: .name))
+    }
 }
 
