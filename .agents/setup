#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
SECONDS=0

printf '\n[orb setup] Checking system prerequisites\n'
missing=()
for entry in curl:curl xz:xz-utils git:git make:make python3:python3 rg:ripgrep jq:jq shellcheck:shellcheck; do
  command -v "${entry%%:*}" >/dev/null || missing+=("${entry#*:}")
done
if ! dpkg-query -W -f='${Status}' ca-certificates 2>/dev/null | grep -qx 'install ok installed'; then
  missing+=(ca-certificates)
fi
if ((${#missing[@]})); then
  sudo apt-get update
  sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi
printf '[orb setup] Prerequisites ready (%ss)\n' "$SECONDS"

# Use the orb's Nix when available. A single-user fallback needs no daemon
# that would be stopped when setup exits.
export PATH="$HOME/.nix-profile/bin:$PATH"
if ! command -v nix >/dev/null; then
  printf '\n[orb setup] Installing Nix\n'
  curl -fsSL https://releases.nixos.org/nix/nix-2.35.3/install |
    sh -s -- --no-daemon --no-modify-profile
  # shellcheck disable=SC1091
  source "$HOME/.nix-profile/etc/profile.d/nix.sh"
fi
nix_bin="$(command -v nix)"
# Keep existing configuration and enable flakes even on a newly installed Nix.
mkdir -p "$HOME/.config/nix"
feature_line='extra-experimental-features = nix-command flakes'
if ! grep -Fqx "$feature_line" "$HOME/.config/nix/nix.conf" 2>/dev/null; then
  printf '\n%s\n' "$feature_line" >> "$HOME/.config/nix/nix.conf"
fi
nix --version

printf '\n[orb setup] Realizing the flake.lock-pinned development shell\n'
cache_dir="$HOME/.cache/nixos-config-orb"
mkdir -p "$cache_dir"
# The profile is a GC root: snapshots retain the complete development closure.
# Do not build or activate workstation/server configurations in an orb.
time "$nix_bin" print-dev-env --no-update-lock-file --profile "$cache_dir/dev" "$repo_root" >/dev/null

# Amp and supervised services use new non-interactive login shells. Export the
# complete environment there, not just executable symlinks or a nested shell.
# Rewrite our own hook so stale snapshots pick up changes without duplicating
# the profile entry. Nested login shells may reset PATH but inherit IN_NIX_SHELL.
cat > "$cache_dir/login.bash" <<EOF
if [[ "\$PWD" == "$repo_root" || "\$PWD" == "$repo_root/"* ]]; then
  if [[ -z "\${IN_NIX_SHELL:-}" ]] || ! command -v nixfmt >/dev/null; then
    if _nixos_config_env="\$("$nix_bin" print-dev-env --no-update-lock-file "$repo_root")"; then
      eval "\$_nixos_config_env"
      unset _nixos_config_env
    else
      printf 'Failed to load the nixos-config development shell\n' >&2
      return 1
    fi
  fi
fi
EOF
marker='# nixos-config orb development shell'
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  printf '\n%s\nsource "%s/login.bash"\n' "$marker" "$cache_dir" >> "$HOME/.bash_profile"
fi
printf '[orb setup] Ready (%ss total)\n' "$SECONDS"
